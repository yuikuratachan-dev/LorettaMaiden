5,"indent":0,"parameters":[{"code":1,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":17,"indent":null}]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["簡易リンク検査が始まった。"]},{"code":401,"indent":0,"parameters":["\\N[1]の手首に薄い測定リングが巻かれ、向かいにはアカリ。"]},{"code":401,"indent":0,"parameters":["ふたりの間に、ALLを通すケーブルが伸びる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「変なことしたらすぐ切るから。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「変なことって何だよ。俺だって分かってないんだって。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["通電。次の瞬間、アカリの装甲ログが一気に安定域へ入った。"]},{"code":401,"indent":0,"parameters":["整備端末の数値を見たホノカが目を丸くする。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「うそ、急にノイズ減った！ 反応速度も上がってる！」\\F1[honoka3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「す、すごい……。アカリ先輩の肩のブレ、なくなってます……。」\\F1[satuki3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「……ほんとに、何これ。気持ち悪いくらい噛み合う。」\\F1[akari3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「褒めてるのか貶してるのか、どっちだよ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「半分ずつ。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["王国側の研究員がざわめく。ミツキは面白そうに笑った。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ミツキ"]},{"code":401,"indent":0,"parameters":["「決まりだね。\\N[1]、今日から君は第七小隊のオペレーター候補。」\\F1[mituki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「候補ってことは、まだ逃げ道ある？」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ミツキ"]},{"code":401,"indent":0,"parameters":["「ない。」\\F1[mituki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「即答なんだよなあ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["その日の夜。小さな食堂で顔合わせが行われた。"]},{"code":401,"indent":0,"parameters":["質素なスープと硬いパン。でも、みんな妙に席だけは近い。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「じゃあ改めて！ 第七小隊へようこそ、\\N[1]！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「よ、よろしくお願いします……。"]},{"code":401,"indent":0,"parameters":["あの、足を引っ張らないようにします……。」\\F1[satuki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「そこは“頑張ります”でよくない？」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「あ……そ、そうですよね……頑張ります……！」\\F1[satuki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「かわいい！今の採用～！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「盛り上がってるところ悪いけど、明日から実地確認をする。"]},{"code":401,"indent":0,"parameters":["足を引っ張るなら置いていくから。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「飯の席でその圧は重いって。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「重いのは戦場で背負うものよ。慣れなさい。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["言い方はきつい。けれど\\N[1]には分かった。アカリは本気で勝ちたいんだ。"]},{"code":401,"indent":0,"parameters":["勝って、自分が落ちこぼれじゃないと証明したい。"]},{"code":401,"indent":0,"parameters":["だからこそ、昨日の偶然を見逃せない。"]},{"code":121,"indent":0,"parameters":[103,103,1]},{"code":121,"indent":0,"parameters":[104,104,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["翌朝。第七小隊の模擬訓練は、いきなり地獄だった。"]},{"code":401,"indent":0,"parameters":["アカリの突進は速い。サツキの砲撃は重い。ホノカの補助は細かい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["その全部に合わせて指示を出せと言われても、\\N[1]の口は追いつかない。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「遅い！ 左じゃなくて前！ いま欲しいのは迷いじゃなくて指示！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「分かってる、分かってるけど早いって！"]},{"code":401,"indent":0,"parameters":[" お前の足、なんでそんな速いの！？」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「アカリ、煽ると余計に混乱する！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「わ、私も……どこ撃てば……！」\\F1[satuki6]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「サツキは右の的！ ホノカはアカリの後ろ、冷却見て！ "]},{"code":401,"indent":0,"parameters":["アカリはそのまま三歩だけ詰めろ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["半ば叫ぶように出した指示が、不思議