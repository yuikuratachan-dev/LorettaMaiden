{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"a/characters/!Spaceship_decoration2","direction":4,"pattern":1,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":12,"y":3},
{"id":4,"name":"EV004","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["第七小隊の最初の任務は、国境沿い補給路の奪還だった。"]},{"code":401,"indent":0,"parameters":["地図で見ると細い線一本。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["でも、その一本が止まるだけで前線はすぐ痩せる。"]},{"code":401,"indent":0,"parameters":["飯も弾も届かなくなる。地味で、でも大事な任務だ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「前方一・二キロに熱源。ドコロコ三体、簡易砲台二門、"]},{"code":401,"indent":0,"parameters":["たぶん地中に潜伏型もいる。今日は盛り合わせだね。」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「盛り合わせって言い方だけ聞くと少しお得そうなのが腹立つな。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「す、すみません……私、最初に撃つべきですよね……でも外したら……。」\\F1[satuki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「外さない。私が前に出る。その隙に撃てばいいだけ。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「“いいだけ”で片づけるには、敵の砲口が多いんだよなあ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]は端末を開き、地形と敵配置を重ねる。"]},{"code":401,"indent":0,"parameters":["右手の崖、左手の湿地、中央の狭い橋。真正面から行くと砲台の餌だ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「アカリ、正面から見せて引きつける。"]},{"code":401,"indent":0,"parameters":["ホノカは左の遮蔽物まで移動して砲台の死角を作れ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「サツキは俺のカウントで二射だけ。欲張るな。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「二射で足りるわけ？」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「足りなかったら、その時はお前の文句を聞きながら走る。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「じゃ、文句を聞かずに済むように頑張ろっか。」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["開戦。アカリが先に飛び出した。"]},{"code":401,"indent":0,"parameters":["赤い装甲が地面を蹴るたび、砕けた石が跳ねる。"]},{"code":401,"indent":0,"parameters":["敵の照準が一斉に彼女へ向く。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「ほら、見なさい！ 私を無視できる敵なんていないのよ！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「そこは自慢していい。右、半歩ずらせ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["敵砲撃。アカリがかわす。"]},{"code":401,"indent":0,"parameters":["だが二発目で肩装甲の追従が少しだけ遅れた。昨日と同じズレだ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「アカリ、左肩ブレてる！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「アカリ、息を吐け。力みすぎ。俺に合わせろ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「命令しないで。……でも、今だけ聞く！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["その言葉と同時に、\\N[1]の端末に見慣れない脈動が走る。"]},{"code":401,"indent":0,"parameters":["AHL反応。数値は意味不明なのに、やることだけは分かった。"]},{"code":401,"indent":0,"parameters":["流れをつなげばいい。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「サツキ、今！ 一射目、砲台！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「は、はいっ！」\\F1[satuki8]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["青白い砲光が走り、右砲台が吹き飛ぶ。外していない。むしろ完璧だ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「あ、当たった……！」\\F1[satuki8]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「今さら！？ すごいの撃った本人が一番びっくりしてる！」\\F1[honoka3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「二射目は橋の下！ 潜ってるやつを炙れ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["二射目。"]},{"code":401,"indent":0,"parameters":["橋の下に隠れていた潜伏型ドコロコが爆ぜ、泥と火花が噴き上がる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「いいじゃない！ それなら私が前を割る！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリが橋へ突っ込む。"]},{"code":401,"indent":0,"parameters":["だがそこで、最後尾にいた大型ドコロコが腕部を変形させ、"]},{"code":401,"indent":0,"parameters":["ワイヤー弾を発射した。いやらしい拘束武装。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「まずい、捕縛用だ！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「アカリ、跳ぶな！ しゃがめ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「は！？ この距離で！？」\\F1[akari3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["文句を言いながらもアカリは身体を沈めた。"]},{"code":401,"indent":0,"parameters":["ワイヤーが頭上を抜ける。直後、\\N[1]はホノカへ叫んだ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「ホノカ、左ブースターだけ一瞬切れ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「無茶言う！ ……でもできる！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカの遠隔補助でアカリの装甲バランスが一瞬だけ崩れ、"]},{"code":401,"indent":0,"parameters":["その反動で身体がひねられる。結果、敵の死角にぴたりと入り込んだ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「っ、この感じ……昨日より、さらに動く！」\\F1[akari3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「今だ、斬れ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["赤い刃が大型ドコロコを縦に裂いた。補給路の中央が、一気に開く。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「や、やりました……！」\\F1[satuki8]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「やったやった！ でも喜ぶのはあと！ 後方から増援！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["敵の増援は人型だった。ファスト帝国の兵。"]},{"code":401,"indent":0,"parameters":["しかも先頭に立つ男の装いが、どう見ても戦場向きじゃない。"]},{"code":401,"indent":0,"parameters":["無駄に上等なマント、細い笑み、芝居がかった仕草。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["カリストロング大佐"]},{"code":401,"indent":0,"parameters":["「やあやあ、麗しき第七小隊。初めましてかな？"]},{"code":401,"indent":0,"parameters":["いや、君たちのことは前からよく知っているよ。」\\F1[kari1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「初対面でうれしくないタイプの“知ってる”だ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「カリストロング……！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["カリストロング大佐"]},{"code":401,"indent":0,"parameters":["「そう構えないでほしい。"]},{"code":401,"indent":0,"parameters":["私はただ、美しい戦士たちの敗北を見届けるのが好きなだけさ。」\\F1[kari1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「うわ、ほんとに最悪。」\\F1[honoka5]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["カリストロングの部隊は正面衝突を狙わない。"]},{"code":401,"indent":0,"parameters":["煙幕、拘束弾、視界撹乱、嫌がらせみたいな動きのオンパレードだ。"]},{"code":401,"indent":0,"parameters":["第七小隊の連携を崩すことだけに全力を出してくる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「こいつ、倒すより“崩す”のが目的だ。"]},{"code":401,"indent":0,"parameters":["サツキ、深追いするな！ アカリは右！ ホノカは煙幕の風向き計算！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「で、でも撃たないと……！」\\F1[satuki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「撃つのは最後でいい！ お前の砲撃は切り札だ！」\\FF[arata1]"]},{"code":101,