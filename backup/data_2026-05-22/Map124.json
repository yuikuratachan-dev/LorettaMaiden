e":401,"indent":0,"parameters":["サツキは撃つたびに肩を震わせる。ホノカは補助に手一杯だ。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「いったん下がれ！ 一列になるな、横穴を使え！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「下がったら避難民に届かない！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「死んだらもっと届かない！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["きつい言い方になった。アカリが一瞬だけ歯を食いしばる。"]},{"code":401,"indent":0,"parameters":["けれど、その一拍が連携を乱した。"]},{"code":401,"indent":0,"parameters":["敵の腕が伸び、アカリの足首へ絡みつく。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「アカリ！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「っ、この程度……！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["切り払う前に、別の個体が横から突っ込んだ。"]},{"code":401,"indent":0,"parameters":["アカリの身体が壁に叩きつけられる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「アカリ！！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["心臓が嫌な跳ね方をした。頭の奥で、誰かが笑った気がする。"]},{"code":401,"indent":0,"parameters":["古い鉄が軋むような、低い声。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["？？？"]},{"code":401,"indent":0,"parameters":["「おいおい、そこで止まるのか。つまらん。もっと欲しがれ。もっと飢えろ。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「……誰だ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["声は外からじゃない。内側から聞こえる。"]},{"code":401,"indent":0,"parameters":["\\N[1]の視界に、黒い紋様みたいなものが一瞬だけ走った。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["？？？"]},{"code":401,"indent":0,"parameters":["「俺はオルガニール。お前の中で長く寝ていた、"]},{"code":401,"indent":0,"parameters":["遺物精霊みたいなものだ。簡単に言えば、厄介な相棒だな。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「今それ説明する！？」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["オルガニール"]},{"code":401,"indent":0,"parameters":["「今しかないからだ。ほら、あの女を助けたければ、流せ。お前の変な力を。」\\F1[olu1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["理屈は分からない。でも身体はもう動いていた。"]},{"code":401,"indent":0,"parameters":["\\N[1]は端末に手を叩きつけ、アカリの機体へAHLを流し込む。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「アカリ、立て！ まだ終わってない！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["赤い装甲が再起動みたいに脈打つ。"]},{"code":401,"indent":0,"parameters":["アカリの瞳が見開かれ、次の瞬間、動きが一段変わった。"]},{"code":401,"indent":0,"parameters":["無駄が消え、斬撃が鋭くなる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「……なに、これ。身体が軽い……！」\\F1[akari3]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["ホノカ"]},{"code":401,"indent":0,"parameters":["「装甲出力、急上昇！ アカリ、それ今なら押し返せる！」\\F1[honoka1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["サツキ"]},{"code":401,"indent":0,"parameters":["「私も合わせます……！」\\F1[satuki1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]が前線を組み直す。アカリが中央を切り開き、サツキが横穴の敵を焼き、"]},{"code":401,"indent":0,"parameters":["ホノカが崩落ポイントを先に潰す。"]},{"code":401,"indent":0,"parameters":["さっきまで押されていたのが嘘みたいに流れが変わった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「そのまま左！ 避難民のいるシェルターまで一直線だ！」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「言われなくても行くわよ！」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["奥のシェルターには、子どもと老人が何十人もいた。"]},{"code":401,"indent":0,"parameters":["泣き声と安堵の声が一気に押し寄せる。第七小隊は避難誘導を開始した。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["子ども"]},{"code":401,"indent":0,"parameters":["「お姉ちゃん、つよい……。」"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「当たり前でしょ。……でも、遅くなって悪かったわ。」\\F1[akari1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["その横顔は、いつもの尖ったアカリじゃなかった。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「今の言い方、ちょっと優しかったな。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["アカリ"]},{"code":401,"indent":0,"parameters":["「黙って。台無し。」\\F1[akari4]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["帰還後、\\N[1]はひとり整備室で頭を抱えていた。"]},{"code":401,"indent":0,"parameters":["オルガニール。遺物精霊。突然出てきた割に、存在感が強すぎる。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["オルガニール"]},{"code":401,"indent":0,"parameters":["「そんな顔をするな。助かっただろ。」\\F1[olu1]"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\N[1]"]},{"code":401,"indent":0,"parameters":["「助かったけど、説明不足なんだよ。お前、なんなんだ。」\\FF[arata1]"]},{"code":101,"indent":0,"parameters":["",0,0,2